SELECT x.original_ext_source_id, x.angular_distance, x.number_of_neighbours, x.xm_flag, g.source_id, g.ref_epoch, g.ra, g.dec, g.pmra, g.pmdec, g.parallax, g.phot_g_mean_mag, g.bp_rp FROM gaiadr3.hipparcos2_best_neighbour AS x LEFT OUTER JOIN gaiadr3.gaia_source AS g ON x.source_id = g.source_id WHERE x.original_ext_source_id IN (14576,24436,24608,25930,27989,32349,58001) ORDER BY x.original_ext_source_id ASC, g.source_id ASC
