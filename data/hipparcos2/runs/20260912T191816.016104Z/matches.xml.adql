SELECT x.original_ext_source_id, x.angular_distance, x.number_of_neighbours, x.xm_flag, g.source_id, g.ref_epoch, g.ra, g.dec, g.pmra, g.pmdec, g.parallax, g.phot_g_mean_mag, g.bp_rp FROM gaiadr3.hipparcos2_best_neighbour AS x LEFT OUTER JOIN gaiadr3.gaia_source AS g ON x.source_id = g.source_id WHERE x.original_ext_source_id IN (3179,3419,5447,7588,9640,9884,11767,14135,15863,21421,24436,24608,25336,25428,26311,26727,27989,28360,30343,30438,31681,32349,33579,34444,36850,37279,37826,39953,41037,42913,44816,45238,46390,49669,50583,54061,60718,61084,62434,62956,65474,67301,68702,68933,69673,71681,71683,72607,80763,82273,85927,86228,87833,90185,91262,97649,100751,102098,107315,109268,112122,113368,113881) ORDER BY x.original_ext_source_id ASC, g.source_id ASC
