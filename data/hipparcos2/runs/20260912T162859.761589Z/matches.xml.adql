SELECT x.original_ext_source_id, x.angular_distance, x.number_of_neighbours, x.xm_flag, g.source_id, g.ref_epoch, g.ra, g.dec, g.pmra, g.pmdec, g.parallax, g.phot_g_mean_mag, g.bp_rp FROM gaiadr3.hipparcos2_best_neighbour AS x LEFT OUTER JOIN gaiadr3.gaia_source AS g ON x.source_id = g.source_id WHERE x.original_ext_source_id IN (7588,15863,21421,24436,24608,25336,25428,26311,26727,27989,28360,30324,30438,31681,32349,33579,36850,37279,37826,39953,45238,49669,60718,61084,62434,62956,65474,67301,68702,69673,71681,71683,80763,85927,86228,90185,91262,97649,100751,102098,109268,113368) ORDER BY x.original_ext_source_id ASC, g.source_id ASC
